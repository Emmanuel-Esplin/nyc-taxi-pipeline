# Copy to .env to customise `make airflow-up`. All values are optional.

# First and last month the DAG schedules. Unpausing it backfills every month in between
# (each is a ~60 MB download), so bound the range for a quick demo.
PIPELINE_START_MONTH=2025-01
PIPELINE_END_MONTH=2025-03

# Linux only: run containers as your user so ./data stays writable (`id -u`).
# AIRFLOW_UID=1000

# Read trip files from a local folder instead of the TLC CDN (path inside the container).
# PIPELINE_SOURCE_DIR=/opt/airflow/data/source

# Postgres serving database and Metabase. Defaults are local-development values; set real
# ones here for anything shared.
# ANALYTICS_WRITER_PASSWORD=
# METABASE_READER_PASSWORD=
# METABASE_APP_DB_PASSWORD=
# MB_ADMIN_EMAIL=admin@nyc-taxi.local   # used by make bi-bootstrap
# MB_ADMIN_PASSWORD=
