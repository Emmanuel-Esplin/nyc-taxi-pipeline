# Local settings for docker compose, the Makefile and metabase/bootstrap.py.
# Copy-free setup: `make secrets` creates .env from this file and fills every empty secret
# below with a random value. .env is git-ignored; never commit it.

# --- Secrets (generated by `make secrets`; leave empty here) ---------------------------
# Airflow's metadata database superuser (also runs the serving setup).
POSTGRES_PASSWORD=
# Signs Airflow's task tokens; shared by all Airflow services.
AIRFLOW_JWT_SECRET=
# Serving database roles: the pipeline writes, Metabase reads, Metabase's own app DB.
ANALYTICS_WRITER_PASSWORD=
METABASE_READER_PASSWORD=
METABASE_APP_DB_PASSWORD=
# Metabase admin login, created by `make bi-bootstrap`.
MB_ADMIN_PASSWORD=

# --- Settings ---------------------------------------------------------------------------
MB_ADMIN_EMAIL=admin@nyc-taxi.local

# First and last month the DAG schedules. Unpausing it backfills every month in between
# (each is a ~60 MB download), so bound the range for a quick demo.
PIPELINE_START_MONTH=2025-01
PIPELINE_END_MONTH=2025-03

# Linux only: run containers as your user so ./data stays writable (`id -u`).
# AIRFLOW_UID=1000

# Read trip files from a local folder instead of the TLC CDN (path inside the container).
# PIPELINE_SOURCE_DIR=/opt/airflow/data/source
